# AD/ADRD CyberDoctor — required environment variables
# Copy this file to .env and fill in your values.

# Google Gemini API key — required for all LLM-based agents and the eval LLM judge.
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: log verbosity (DEBUG | INFO | WARNING | ERROR). Defaults to INFO.
# LOG_LEVEL=INFO

# Optional (Docker / docker-compose only): FastAPI base URL used by the Streamlit frontend.
# Uncomment when running via docker-compose; leave commented for local dev.
# API_BASE=http://api:8000
